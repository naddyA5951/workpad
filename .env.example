# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Automatically injected by platform)
SQL_HOST="/cloudsql/instance"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_DB_NAME="postgres"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# Session & Authentication Secret
SESSION_SECRET="replace_with_32_byte_random_secret_in_production"

# Razorpay Payment Gateway Credentials (Test Mode by default)
RAZORPAY_KEY_ID="rzp_test_NoteCraftDemoKey"
RAZORPAY_KEY_SECRET="rzp_test_secret_NoteCraftDemoSecret"
RAZORPAY_WEBHOOK_SECRET="whsec_NoteCraftWebhookSecret"

